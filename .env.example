# ===========================================================================
# TechEdu LMS — root environment file for docker-compose.yml
# Copy to .env and fill in real values before running `docker compose up`.
# ===========================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root-password
# Username is fixed to "techedu" — see docker/mysql-init/01-init-databases.sql
MYSQL_USER=techedu
MYSQL_PASSWORD=change-me-app-db-password

# ---- Shared secret across auth-service and content-service ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32+-byte-secret
JWT_EXPIRE_MINUTES=1440

# ---- First admin account, auto-created by auth-service on first startup ----
ADMIN_EMAIL=admin@techedu.dev
ADMIN_PASSWORD=change-me-strong-admin-password

# ---- Host ports (change if any of these are already taken on your machine) ----
GATEWAY_PORT=8080
LANDING_PORT=3000
ADMIN_PORT=3001
LEARNING_PORTAL_PORT=3002
MYSQL_PORT=3306

# ---- URLs the frontends are built with (baked into the browser bundle —
# these must be reachable from wherever the person's BROWSER runs, not
# from inside the Docker network) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
NEXT_PUBLIC_LEARNING_PORTAL_URL=http://localhost:3002

# ---- CORS: which frontend origins the backend services accept ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ---- Optional: leave unset to disable telemetry entirely (default) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
