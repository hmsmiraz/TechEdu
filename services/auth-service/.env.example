# For local dev without MySQL running, sqlite:///./auth_dev.db also works.
DATABASE_URL=mysql+pymysql://techedu:techedu@localhost:3306/auth_db

# Generate a real one with: openssl rand -hex 32
# Must match the SAME value in content-service's env so it can verify tokens.
JWT_SECRET=change-me-to-a-random-32+-byte-secret
JWT_EXPIRE_MINUTES=1440

# First admin account, auto-created on first startup if no admin exists yet.
ADMIN_EMAIL=admin@techedu.dev
ADMIN_PASSWORD=change-me-strong-password

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
