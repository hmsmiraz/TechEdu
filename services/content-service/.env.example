# For local dev without MySQL running, sqlite:///./content_dev.db also works.
DATABASE_URL=mysql+pymysql://techedu:techedu@localhost:3306/content_db

# MUST be the exact same value as auth-service's JWT_SECRET — this is how
# content-service verifies tokens without ever calling auth-service.
JWT_SECRET=change-me-to-a-random-32+-byte-secret

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002