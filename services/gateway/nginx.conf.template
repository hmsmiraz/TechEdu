server {
    listen 80;

    # ---- auth-service ----
    location /api/auth {
        proxy_pass http://${AUTH_SERVICE_HOST}:${AUTH_SERVICE_PORT}/auth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/admin/users {
        proxy_pass http://${AUTH_SERVICE_HOST}:${AUTH_SERVICE_PORT}/admin/users;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- content-service ----
    location /api/modules {
        proxy_pass http://${CONTENT_SERVICE_HOST}:${CONTENT_SERVICE_PORT}/modules;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/admin/modules {
        proxy_pass http://${CONTENT_SERVICE_HOST}:${CONTENT_SERVICE_PORT}/admin/modules;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/admin/resources {
        proxy_pass http://${CONTENT_SERVICE_HOST}:${CONTENT_SERVICE_PORT}/admin/resources;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- frontends ----
    # Each Next.js app is built with a matching basePath, so the incoming
    # path (including the /admin or /portal prefix) is passed through
    # UNCHANGED — proxy_pass has no path component here on purpose, which
    # tells nginx to forward the original URI as-is rather than rewriting
    # it against the location's matched prefix.
    location /admin {
        proxy_pass http://${ADMIN_SERVICE_HOST}:${ADMIN_SERVICE_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /portal {
        proxy_pass http://${LEARNING_PORTAL_SERVICE_HOST}:${LEARNING_PORTAL_SERVICE_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # landing stays at root — no basePath needed on that app
    location / {
        proxy_pass http://${LANDING_SERVICE_HOST}:${LANDING_SERVICE_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        return 200 "gateway ok\n";
        add_header Content-Type text/plain;
    }

    location = /health/auth {
        proxy_pass http://${AUTH_SERVICE_HOST}:${AUTH_SERVICE_PORT}/health;
    }

    location = /health/content {
        proxy_pass http://${CONTENT_SERVICE_HOST}:${CONTENT_SERVICE_PORT}/health;
    }
}
